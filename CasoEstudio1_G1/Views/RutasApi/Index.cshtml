@model IEnumerable<CasoEstudio1_G1.Models.Ruta>

@{
    ViewData["Title"] = "Rutas Disponibles";
}

<h1>Rutas Disponibles</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Descripción de la ruta
            </th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreRuta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>

                <td>
                    <a class="btn btn-outline-warning" asp-controller="RutasApi" asp-action="Details" asp-route-id="@item.Id">Ver Detalles</a>
                    <a class="btn btn-outline-primary" asp-controller="Horario" asp-action="VerHorarios" asp-route-id="@item.Id">Horarios</a>


                </td>
        </tr>
}
    </tbody>
</table>
