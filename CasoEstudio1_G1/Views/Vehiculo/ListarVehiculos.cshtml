@model IEnumerable<Vehiculo>

@{
    ViewData["Title"] = "Listado de Vehículos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="fw-bold text-primary">Administrador</h1>
        <a href="@Url.Action("CrearVehiculo")" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Agregar Vehículo
        </a>
    </div>

    <h2 class="mt-3 text-secondary">Gestión de Vehículos</h2>

    <div class="card shadow mt-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Lista de Vehículos</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Placa</th>
                            <th>Modelo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehiculo in Model)
                        {
                            <tr>
                                <td>@vehiculo.Placa</td>
                                <td>@vehiculo.Modelo</td>
                                <td>
                                    <span class="badge @(vehiculo.Estado.Nombre == "Disponible" ? "bg-success" : "bg-danger")">
                                        @vehiculo.Estado.Nombre
                                    </span>
                                </td>
                                <td>
                                    <a href="@Url.Action("EditarVehiculo", new { id = vehiculo.Id })" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <form method="post" asp-action="EliminarVehiculo" class="d-inline-block" onsubmit="return confirm('¿Estás seguro de eliminar este vehículo?')">
                                        <input type="hidden" name="id" value="@vehiculo.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
