@model CasoEstudio1_G1.Models.DashboardViewModel

<div class="container mt-5">
    <h2 class="text-center mb-4">📊 Dashboard</h2>

    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-lg text-center p-3 rounded">
                <div class="card-body">
                    <i class="fas fa-route fa-3x mb-2"></i>
                    <h5 class="card-title">Rutas Activas</h5>
                    <h1 class="display-4">@Model.RutasActivas</h1>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success shadow-lg text-center p-3 rounded">
                <div class="card-body">
                    <i class="fas fa-bus fa-3x mb-2"></i>
                    <h5 class="card-title">Vehículos en Buen Estado</h5>
                    <h1 class="display-4">@Model.VehiculosBuenos</h1>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-warning shadow-lg text-center p-3 rounded">
                <div class="card-body">
                    <i class="fas fa-ticket-alt fa-3x mb-2"></i>
                    <h5 class="card-title">Boletos Vendidos</h5>
                    <h1 class="display-4">@Model.BoletosVendidos</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Agregar FontAwesome para los íconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">