@model IEnumerable<CasoEstudio1_G1.Models.HorarioRuta>

@{
    ViewData["Title"] = "Ver Horarios";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white text-center">
            <h2 class="mb-0">Ver Horarios</h2>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-warning text-center" role="alert">
                    No hay horarios disponibles.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Horario)</th>
                                <th>@Html.DisplayNameFor(model => model.Ruta)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>@(item.Horario != null ? item.Horario.Hora.ToString() : "Sin horario")</td>
                                    <td>@(item.Ruta != null ? item.Ruta.NombreRuta.ToString() : "Sin ruta")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>