@model IEnumerable<Boleto>

@{
    ViewData["Title"] = "Boletos Vendidos";
}

<div class="container mt-4">
    <div class="text-center">
        <h1 class="fw-bold text-primary">Administrador</h1>
        <h1 class="fw-bold text-primary">Boletos Vendidos</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">No hay boletos vendidos aún.</div>
    }
    else
    {
        <div class="card shadow mt-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Lista de Boletos</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered text-center align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Placa</th>
                                <th>Modelo</th>
                                <th>Ruta</th>
                                <th>Fecha de Compra</th>
                                <th>Pasajero</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var boleto in Model)
                            {
                                <tr>
                                    <td>@boleto.Vehiculo.Placa</td>
                                    <td>@boleto.Vehiculo.Modelo</td>
                                    <td>@boleto.Vehiculo.Ruta.NombreRuta</td>
                                    <td>@boleto.Vehiculo.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td>@boleto.Usuario.NombreUsuario</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
