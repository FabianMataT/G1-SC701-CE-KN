<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CasoEstudio1_G1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CasoEstudio1_G1.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="bg-primary">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-primary border-bottom box-shadow">
            <div class="container-fluid bg-primary">
                <a class="navbar-brand text-light fw-bold" asp-area="" asp-controller="Home" asp-action="Index">CasoEstudio1_G1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" asp-area="" asp-controller="Vehiculo" asp-action="ListarVehiculos">Gestión de Vehiculos</a>
                        </li>

                        <!-- Dropdown de Boletos -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light fw-bold" href="#" id="boletosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Boletos
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="boletosDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Boletos" asp-action="ComprarBoleto">Comprar Boleto</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Boletos" asp-action="BoletosVendidos">Boletos Vendidos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Boletos" asp-action="BoletosPorRutaAsignada">Boletos Vendidos Por Ruta</a></li>
                            </ul>
                        </li>

                        <!-- Dropdown de Rutas -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light fw-bold" href="#" id="rutasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Rutas
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="rutasDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Ruta" asp-action="Index">Gestionar Rutas</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="RutasApi" asp-action="Index">Consultar Rutas Disponibles</a></li>
                            </ul>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" asp-area="" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Dashboard">Dashboard para Admins</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CasoEstudio1_G1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
